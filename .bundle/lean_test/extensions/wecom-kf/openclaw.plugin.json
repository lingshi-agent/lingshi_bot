{
  "id": "wecom-kf",
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "serverBaseUrl": { "type": "string" },
      "deviceId": { "type": "string" },
