  "uiHints": {
    "enabled": { "label": "Enable WeCom KF" },
    "serverBaseUrl": { "label": "Server Base URL" },
    "deviceId": { "label": "Device ID (optional)" },
    "localAgentId": { "label": "Local Agent ID", "advanced": true },
    "localAgentTimeoutSeconds": { "label": "Local Agent Timeout (s)", "advanced": true },
    "skipHistory": { "label": "Skip History (Only New Messages)" },
    "sessionMapPath": { "label": "Session Map Path", "advanced": true }
  }
